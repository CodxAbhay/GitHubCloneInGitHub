PORT=3002
MONGODB_URI=mongodb+srv://...
JWT_SECRET_KEY=change-me

# AWS S3 for repo files (code also reads S3_BUCKET_NAME in aws_config — set both or align config)
S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1

# Upload limits (abuse protection for free-tier S3)
MAX_UPLOAD_FILE_MB=10
MAX_UPLOAD_TOTAL_MB=50
MAX_FILES_PER_COMMIT=200

# Rate limit: POST /commit/create per IP (window ms and max requests)
RATE_LIMIT_COMMIT_WINDOW_MS=900000
RATE_LIMIT_COMMIT_MAX=60

